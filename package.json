{
  "name": "siyuan-plugin-reword",
  "version": "1.5.1",
  "description": "RE word - offline dictionary lookup and vocabulary review plugin for SiYuan",
  "scripts": {
    "dev": "vite build --watch",
    "check": "tsc --noEmit",
    "build": "vite build && tsc --noEmit && node scripts/copy-dist.mjs",
    "make": "vite build && tsc --noEmit && node scripts/copy-dist.mjs && python scripts/make_release.py",
    "test": "node test/run-all.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.0.0",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "sass": "^1.63.3",
    "svelte": "^4.2.20",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "construct-style-sheets-polyfill": "^3.1.0",
    "fflate": "^0.8.3",
    "js-mdict": "^7.0.0",
    "katex": "^0.16.25",
    "siyuan": "^1.0.0"
  }
}
